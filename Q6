#In this program some arithmetic operators are used.
print("This program is do some arithmetic operations, please enter two numbers a and b")
 a = int(input("Enter the first value,a:"))
b = int(input("Enter the second value,b:"))
print("Addition:",a+b) print("Subraction:",a-b)
print("Multiplication:",a*b)
print("Division:",a/b)
print("Floor Division:",a//b)#it provides only the absolute value of the answer.
print("Modulus:",a%b)#it gives only the remainder as the answer after division, useful in various areas 
print("Raise to:",a**b)# it multiples a, b times